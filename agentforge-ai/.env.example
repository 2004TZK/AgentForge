# AgentForge AI Service 环境变量样例
# 复制为 .env 后填写；未配置 LLM Key 时进入 Mock 模式，本地开发不依赖外部服务

# 内部鉴权 Token（与后端 agentforge.ai.internal-token 保持一致）
INTERNAL_TOKEN=dev-internal-token

# LLM（OpenAI 兼容：Qwen 千问云端 / 自建 Ollama）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus

# Embedding（千问 text-embedding-v3；未配置时使用本地哈希 Mock 向量）
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# 中间件
QDRANT_HOST=localhost
QDRANT_PORT=6333
REDIS_HOST=localhost
REDIS_PORT=6379

# 共享文件卷（RAG 解析读取）
UPLOAD_DIR=/data/uploads

# M5 沙箱执行器（代码工具受限执行；本地开发 docker compose 起 sandbox 后填 http://localhost:8700）
SANDBOX_BASE_URL=http://localhost:8700
SANDBOX_INTERNAL_TOKEN=dev-sandbox-token
# HTTP 自定义工具 SSRF 防护（默认开启）
HTTP_TOOL_SSRF_ENABLED=true
