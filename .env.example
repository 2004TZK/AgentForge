# ============================================================
# AgentForge 环境变量样例
# 复制为 .env 后填写真实值（.env 已被 gitignore，不会提交）
# ============================================================

# ---- 对外端口 ----
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=agentforge
MYSQL_USER=agentforge
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PORT=6379

# ---- Qdrant ----
QDRANT_PORT=6333

# ---- 后端 ----
BACKEND_PORT=8080
JWT_SECRET=change-me-please-this-must-be-at-least-32-bytes-long
JWT_EXPIRE_HOURS=24

# ---- AI 服务（决策 v1.4：千问云端 API，OpenAI 兼容，无本地模型） ----
AI_PORT=8000
INTERNAL_TOKEN=change-me-internal-token

# 千问百炼/DashScope 兼容模式 API Key（platform.qianwenai.com 申请，sk- 开头）
LLM_API_KEY=
# 可选：GitHub 工具 API Token（提升匿名 60 次/小时限流；也可在 Agent 工具配置中按智能体填 api_key）
GITHUB_TOKEN=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
LLM_LOCAL=false
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
QDRANT_HOST=qdrant
