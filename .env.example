# ============================================================
# AgentForge 环境变量样例
# 复制为 .env 后填写真实值（.env 已被 gitignore，不会提交）
# ============================================================

# ---- 对外端口 ----
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=agentforge
MYSQL_USER=agentforge
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PORT=6379

# ---- Qdrant ----
QDRANT_PORT=6333

# ---- 后端 ----
BACKEND_PORT=8080
JWT_SECRET=change-me-please-this-must-be-at-least-32-bytes-long
JWT_EXPIRE_HOURS=24

# ---- AI 服务 ----
AI_PORT=8000
INTERNAL_TOKEN=change-me-internal-token
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
EMBEDDING_MODEL=
QDRANT_HOST=qdrant
