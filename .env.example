# ============================================================
# AgentForge 环境变量样例
# 复制为 .env 后填写真实值（.env 已被 gitignore，不会提交）
# ============================================================

# ---- 对外端口 ----
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=agentforge
MYSQL_USER=agentforge
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PORT=6379

# ---- Qdrant ----
QDRANT_PORT=6333

# ---- 后端 ----
BACKEND_PORT=8080
JWT_SECRET=change-me-please-this-must-be-at-least-32-bytes-long
JWT_EXPIRE_HOURS=24

# ---- AI 服务 ----
AI_PORT=8000
INTERNAL_TOKEN=change-me-internal-token

# 决策 v1.2：全部本地模型（Ollama），不使用 DeepSeek；本地模型无需 API Key
# 若需切回远端模型：填 LLM_API_KEY 并改 LLM_BASE_URL/LLM_MODEL 即可（代码层 OpenAI 兼容）
LLM_API_KEY=
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3.5:0.8b
LLM_THINK=false
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
QDRANT_HOST=qdrant

# Ollama 模型拉取失败时的兜底：Embedding 可临时换 nomic-embed-text（维度 768，
# 需同步改 EMBEDDING_DIM=768 并运行 scripts/rebuild_qdrant.py 重建集合）
